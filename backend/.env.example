# ---- Database (Supabase Postgres connection string) ----
# Supabase dashboard → Settings → Database → Connection string → "URI".
# Use the DIRECT connection (port 5432) — simplest, works for both setup and runtime.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Auth ----
JWT_ACCESS_SECRET="change-me-long-random-string-1"
JWT_REFRESH_SECRET="change-me-long-random-string-2"

# ---- Server ----
PORT="4000"
FRONTEND_URL="http://localhost:3000"
# This API's own public URL — used to build the one-click approve/reject links in
# the admin signup email. Local default is fine; set to your API host in prod.
API_URL="http://localhost:4000"
NODE_ENV="development"
# Optional hard cap on total registered accounts (leave blank for unlimited).
MAX_USERS=""
# Optional rate-limit overrides (sensible defaults applied if unset):
#   RL_GLOBAL_MAX (per IP / 15 min, default 600)
#   RL_AUTH_MAX   (per IP / 15 min on /api/auth, default 10, failures only)
#   RL_AI_MAX     (per user / hour on /api/ai, default 40)

# ---- Seed admin (created by `npm run setup`) ----
ADMIN_EMAIL="viswanathan122000@gmail.com"
ADMIN_PASSWORD="changeme1234"

# ---- AI provider key (server-side; this is the only key the app uses) ----
AI_API_KEY=""
# Model. Sonnet is the cost/quality sweet spot; Haiku is cheapest; Opus dearest.
AI_MODEL="claude-sonnet-4-6"

# ---- AI spend caps (soft, in-app). Hard cap = Anthropic Console spend limit. ----
# Rolling window cap: at most $2 of AI spend per 3 hours, then AI pauses until it frees up.
AI_BUDGET_WINDOW_USD="2"
AI_BUDGET_WINDOW_HOURS="3"
# Monthly cap (keep under your ~$20/mo budget).
AI_BUDGET_MONTH_USD="18"
# Token prices per 1M (match your model; defaults are Sonnet list pricing).
AI_PRICE_IN_PER_M="3"
AI_PRICE_OUT_PER_M="15"
# Set to 1 to disable the in-app spend guard entirely.
# AI_BUDGET_DISABLED="0"

# ---- Email (Gmail SMTP via Nodemailer) ----
# Used for: new-signup notice to admin, account-approved notice to the user,
# and the daily learning-topic email. Create an App Password at
# Google Account → Security → 2-Step Verification → App passwords.
# Leave blank to disable email (the app still runs; sends become no-ops).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Optional display "from"; defaults to GMAIL_USER.
MAIL_FROM="Prompt2Resume <viswanathan122000@gmail.com>"

# ---- Daily learning email scheduler (in-process; no external cron needed) ----
# Set a cron expression to auto-send the daily learning email while the server
# runs. Leave BLANK in production if you use the Render cron service (avoids
# double-send). Example: every day at 13:00.
DAILY_LEARNING_CRON="0 13 * * *"
# Optional timezone for the schedule (IANA name). Defaults to server time.
DAILY_LEARNING_TZ="Asia/Kolkata"
