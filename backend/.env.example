# ---- Database (Supabase Postgres connection string) ----
# Supabase dashboard → Settings → Database → Connection string → "URI".
# Use the DIRECT connection (port 5432) — simplest, works for both setup and runtime.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Auth ----
JWT_ACCESS_SECRET="change-me-long-random-string-1"
JWT_REFRESH_SECRET="change-me-long-random-string-2"

# ---- Server ----
PORT="4000"
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Seed admin (created by `npm run setup`) ----
ADMIN_EMAIL="viswanathan122000@gmail.com"
ADMIN_PASSWORD="changeme1234"

# ---- AI provider key (server-side; this is the only key the app uses) ----
AI_API_KEY=""
# Optional model override.
# AI_MODEL="claude-opus-4-8"
