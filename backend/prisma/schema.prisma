generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String    @default("")
  email              String    @unique
  passwordHash       String
  role               String    @default("user") // user | admin
  approved           Boolean   @default(false)
  plan               String    @default("free") // free | pro
  planRenewsAt       DateTime?
  dailyDownloadLimit Int       @default(3)
  bonusDownloads     Int       @default(0)
  bonusExpires       DateTime?
  createdAt          DateTime  @default(now())
  lastLoginAt        DateTime?

  // Broadcast email opt-out. Defaulted, so existing rows stay reachable.
  emailOptOut       Boolean   @default(false)
  // Nullable on purpose. A NOT NULL UNIQUE column cannot be added to a table
  // that already has rows - there is nothing to put in it, and Prisma's
  // @default(cuid()) is generated by the client, not by Postgres. Filled in
  // the first time we email someone.
  unsubscribeToken  String?   @unique

  // Bumped to revoke all of a user's issued tokens (e.g. on logout).
  tokenVersion       Int       @default(0)

  // Daily learning email — personalized from the user's "Learn by building" profile.
  learnTech           String?   // last tech they asked to learn
  learnLevel          String    @default("beginner") // beginner | intermediate | advanced
  dailyLearningEmail  Boolean   @default(false) // opt-in to the daily learning-topic email
  lastLearningEmailAt DateTime?

  // Learn streak (the "come back daily" hook)
  learnStreak    Int       @default(0)
  learnStreakAt  DateTime?

  resumes      Resume[]
  roadmaps     LearningRoadmap[]
  versions     ResumeVersion[]
  downloads    DownloadLog[]
  applications JobApplication[]
  routineItems RoutineItem[]
  testimonial  Testimonial?
  broadcastSends BroadcastSend[]
}

model RoutineItem {
  id        String   @id @default(cuid())
  userId    String
  text      String
  category  String   @default("Task") // Task | Learning | Gym | Habit
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  role      String   @default("")
  text      String
  rating    Int      @default(5)
  approved  Boolean  @default(true) // shown on landing
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id             String   @id @default(cuid())
  userId         String
  title          String   @default("Untitled Resume")
  targetRole     String?
  sourceMaterial String?
  jobDescription String?
  templateId     String   @default("classic")
  contentJson    Json     @default("{}")
  styleJson      Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions ResumeVersion[]

  @@index([userId])
}

model ResumeVersion {
  id              String   @id @default(cuid())
  resumeId        String
  userId          String
  versionName     String
  templateId      String   @default("classic")
  contentJson     Json     @default("{}")
  styleJson       Json     @default("{}")
  jobDescription  String?
  downloadedCount Int      @default(0)
  createdAt       DateTime @default(now())

  resume       Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloads    DownloadLog[]
  applications JobApplication[]

  @@index([resumeId])
}

model DownloadLog {
  id              String   @id @default(cuid())
  userId          String
  resumeVersionId String?
  fileType        String
  promoCodeUsed   String?
  status          String   @default("success") // success | blocked
  downloadedAt    DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  version ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)

  @@index([userId, downloadedAt])
}

model LearningRoadmap {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  level     String   @default("beginner")
  summary   String   @default("")
  steps     Json     @default("[]") // [{ title, detail, resource, done }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiUsage {
  id           String   @id @default(cuid())
  userId       String?
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String // one_time | daily_unlock | friend_access
  maxUses        Int       @default(1)
  usedCount      Int       @default(0)
  expiryDate     DateTime?
  assignedUserId String?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
}

model JobApplication {
  id              String    @id @default(cuid())
  userId          String
  companyName     String    @default("")
  jobTitle        String    @default("")
  jobDescription  String?
  resumeVersionId String?
  status          String    @default("Saved")
  dateApplied     DateTime?
  followUpDate    DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  version ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)

  @@index([userId])
}


// ---------------------------------------------------------------------------
// Broadcasts - one-off announcement emails to the user base.
//
// A Broadcast is the message. A BroadcastSend is one attempt at one person,
// and the unique constraint on (broadcastId, userId) is what makes sending
// idempotent: a crashed or half-finished run can simply be run again, and
// nobody receives it twice. That property is the whole reason this is a table
// rather than a for-loop over prisma.user.findMany().
// ---------------------------------------------------------------------------

model Broadcast {
  id        String    @id @default(cuid())
  subject   String
  body      String    // plain text; {name} is replaced per recipient
  status    String    @default("draft") // draft | sending | sent
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  sends BroadcastSend[]
}

model BroadcastSend {
  id          String    @id @default(cuid())
  broadcastId String
  userId      String
  email       String
  status      String    @default("sent") // sent | failed | skipped
  error       String?
  sentAt      DateTime  @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([broadcastId])
}


// ---------------------------------------------------------------------------
// Waitlist - people who want the next thing before it exists.
//
// Deliberately not a relation to User: most of these are strangers who have no
// account yet, and the ones who do can sign up again without anything special
// happening. Email is unique, so a second submission is a no-op rather than a
// duplicate.
// ---------------------------------------------------------------------------

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("landing")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
