{
  "name": "prompt2resume-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Prompt2Resume API — Express + Prisma + JWT",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "setup": "prisma generate && prisma db push && node prisma/seed.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "daily:learning": "node src/jobs/dailyLearning.js",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "prisma": "^5.19.1"
  }
}
